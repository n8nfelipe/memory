# Local SQLite database. Defaults to ~/.llm-memory/memory.db
MEMORY_DATABASE_URL=sqlite:///~/.llm-memory/memory.db

# Set true only when exposing the API beyond loopback. Create tokens with:
# memory token create --owner-id your-user-id
MEMORY_AUTH_REQUIRED=false

# Local service binds to loopback by default.
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8765

# Optional memory controls. Zero disables count/size limits; blank TTL means no default expiry.
MEMORY_MAX_ENTRIES_PER_OWNER=0
MEMORY_MAX_BYTES_PER_OWNER=0
MEMORY_DEFAULT_TTL_DAYS=
MEMORY_ALLOWED_KINDS=

# Optional semantic search. Content is sent to this explicitly configured endpoint.
# Leave blank to use lexical search only.
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_API_KEY=
