# Copy to .env before `docker compose up -d` and replace with a long random
# URL-safe value (letters, digits, underscore, hyphen).
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# Optional policy controls.
MEMORY_MAX_ENTRIES_PER_OWNER=0
MEMORY_MAX_BYTES_PER_OWNER=0
MEMORY_DEFAULT_TTL_DAYS=
MEMORY_ALLOWED_KINDS=

# Optional OpenAI-compatible embeddings endpoint. Stored content is sent there
# only when configured. Leave blank for lexical search only.
MEMORY_EMBEDDING_URL=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_API_KEY=
